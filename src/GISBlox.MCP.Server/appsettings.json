{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mcp": {
    "Http": {
      "Enabled": true,
      "Port": "8080"
    },
    "Stdio": {
      "Enabled": true
    }
  },
  "UsageTokens": {
    "IngestUrl": "https://services.gisblox.com/api/usage/ingest",
    "CostRules": {
      "ByteDivisor": 3000,
      "DurationDivisor": 40,
      "VertexDivisor": 400
    }
  }
}
